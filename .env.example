# Generated automatically by `bash pwatruckpocket setup`.
# These values are safe examples only. Never commit the real .env file.

DEPLOYMENT_MODE="local"
PB_VERSION="0.39.9"
PB_BIND_ADDRESS="127.0.0.1"
PB_PORT="8090"
PUBLIC_BASE_URL="http://127.0.0.1:8090"
APP_DISPLAY_NAME="PwaTruckPocket Drivers"

# Generate unique values for every deployment.
PB_ENCRYPTION_KEY="replace_with_32_hex_characters"
PB_SUPERUSER_EMAIL="admin@example.com"
PB_SUPERUSER_PASSWORD="replace_with_a_strong_admin_password"

# Synthetic demo account.
DEMO_DRIVER_NAME="Mario Demo"
DEMO_DRIVER_EMAIL="driver@example.com"
DEMO_DRIVER_PASSWORD="replace_with_a_strong_demo_password"

# Optional Telegram integration. Leave empty for a local demo.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Cloudflare remotely-managed tunnel. Used only with DEPLOYMENT_MODE=remote.
CLOUDFLARE_TOKEN=""

#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"
BACKUP_DIR="$ROOT_DIR/backups"
DATA_VOLUME="pwatruckpocket_pocketbase-data"

if [[ -t 1 ]]; then
  BOLD='\033[1m'
  BLUE='\033[34m'
  GREEN='\033[32m'
  YELLOW='\033[33m'
  RED='\033[31m'
  RESET='\033[0m'
else
  BOLD=''
  BLUE=''
  GREEN=''
  YELLOW=''
  RED=''
  RESET=''
fi

info() { printf "%b%s%b\n" "$BLUE" "$*" "$RESET"; }
ok() { printf "%b%s%b\n" "$GREEN" "$*" "$RESET"; }
warn() { printf "%b%s%b\n" "$YELLOW" "$*" "$RESET"; }
die() { printf "%b%s%b\n" "$RED" "$*" "$RESET" >&2; exit 1; }

usage() {
  cat <<'USAGE'
PwaTruckPocket — driver workflow demo

Usage:
  bash pwatruckpocket setup
  bash pwatruckpocket start
  bash pwatruckpocket stop
  bash pwatruckpocket status
  bash pwatruckpocket doctor
  bash pwatruckpocket logs [pocketbase|tunnel]
  bash pwatruckpocket backup
  bash pwatruckpocket update
  bash pwatruckpocket demo
  bash pwatruckpocket credentials
USAGE
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

require_docker() {
  need docker
  docker compose version >/dev/null 2>&1 || die 'Docker Compose v2 is required.'
  docker info >/dev/null 2>&1 || die 'Docker daemon is not reachable.'
}

random_hex() {
  local bytes="${1:-24}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
  else
    od -An -N "$bytes" -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
  fi
}

read_default() {
  local prompt="$1" default="$2" value
  read -r -p "$prompt [$default]: " value
  printf '%s' "${value:-$default}"
}

read_secret() {
  local prompt="$1" value
  read -r -s -p "$prompt: " value
  printf '\n' >&2
  printf '%s' "$value"
}

env_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\\$}
  printf '%s' "$value"
}

load_env() {
  [[ -f "$ENV_FILE" ]] || die 'Missing .env. Run: bash pwatruckpocket setup'
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

profile_args() {
  if [[ "${DEPLOYMENT_MODE:-local}" == remote ]]; then
    printf '%s\n' '--profile' 'remote'
  fi
}

compose() {
  local args=()
  while IFS= read -r item; do
    args+=("$item")
  done < <(profile_args)
  (cd "$ROOT_DIR" && docker compose "${args[@]}" "$@")
}

service_state() {
  local service="$1" cid
  cid="$(compose ps -q "$service" 2>/dev/null || true)"
  if [[ -z "$cid" ]]; then
    printf 'not-created'
    return
  fi
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || printf unknown
}

wait_for_pocketbase() {
  local i state
  info 'Waiting for PocketBase and schema migrations...'
  for ((i=1; i<=60; i++)); do
    state="$(service_state pocketbase)"
    case "$state" in
      healthy)
        printf '\n'
        ok 'PocketBase is healthy.'
        return 0
        ;;
      unhealthy|exited|dead)
        printf '\n'
        compose logs --tail=120 pocketbase >&2 || true
        die "PocketBase entered state: $state"
        ;;
    esac
    printf '.'
    sleep 3
  done
  printf '\n'
  compose logs --tail=120 pocketbase >&2 || true
  die 'PocketBase did not become healthy in time.'
}

admin_token() {
  local response token
  response="$(curl -fsS "http://127.0.0.1:${PB_PORT}/api/collections/_superusers/auth-with-password" \
    -H 'Content-Type: application/json' \
    --data "{\"identity\":\"$PB_SUPERUSER_EMAIL\",\"password\":\"$PB_SUPERUSER_PASSWORD\"}")"
  token="$(printf '%s' "$response" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
  [[ -n "$token" ]] || die 'Could not authenticate the local PocketBase superuser.'
  printf '%s' "$token"
}

create_demo_account() {
  local token create_response http_code driver_code
  token="$(admin_token)"

  create_response="$(curl -sS -w '\n%{http_code}' "http://127.0.0.1:${PB_PORT}/api/collections/users/records" \
    -H "Authorization: $token" \
    -H 'Content-Type: application/json' \
    --data "{\"email\":\"$DEMO_DRIVER_EMAIL\",\"password\":\"$DEMO_DRIVER_PASSWORD\",\"passwordConfirm\":\"$DEMO_DRIVER_PASSWORD\",\"name\":\"$DEMO_DRIVER_NAME\",\"role\":\"driver\",\"language\":\"it\",\"active\":true}")"
  http_code="$(printf '%s' "$create_response" | tail -n1)"

  case "$http_code" in
    200|201)
      ok 'Synthetic demo driver created.'
      ;;
    400)
      driver_code="$(curl -sS -o /dev/null -w '%{http_code}' \
        "http://127.0.0.1:${PB_PORT}/api/collections/users/auth-with-password" \
        -H 'Content-Type: application/json' \
        --data "{\"identity\":\"$DEMO_DRIVER_EMAIL\",\"password\":\"$DEMO_DRIVER_PASSWORD\"}" || true)"
      if [[ "$driver_code" == 200 ]]; then
        ok 'Synthetic demo driver already exists.'
      else
        die 'A driver with the demo email already exists but its generated password does not match the current .env.'
      fi
      ;;
    *)
      die "Demo driver creation failed: HTTP $http_code"
      ;;
  esac
}

print_ready() {
  printf '\n%bReady.%b\n' "$GREEN$BOLD" "$RESET"
  printf 'URL:      %s\nDriver:   %s\nPassword: %s\n' "$PUBLIC_BASE_URL" "$DEMO_DRIVER_EMAIL" "$DEMO_DRIVER_PASSWORD"
  printf '\nRun: bash pwatruckpocket doctor && bash pwatruckpocket demo\n'
}

start_stack() {
  compose config --quiet
  compose up -d --build --remove-orphans
  wait_for_pocketbase
  create_demo_account
}

setup() {
  require_docker
  need curl
  umask 077
  mkdir -p "$BACKUP_DIR"

  printf "%bPwaTruckPocket guided setup%b\n\n" "$BOLD" "$RESET"

  if [[ -f "$ENV_FILE" ]]; then
    warn 'Existing configuration detected; reusing it without rotating credentials.'
    load_env
    start_stack
    print_ready
    return
  fi

  local app_name super_email driver_name driver_email mode_choice deployment_mode bind_address port public_url tunnel_token=""
  local super_password driver_password encryption_key telegram_token="" telegram_chat=""

  app_name="$(read_default 'Application display name' 'PwaTruckPocket Drivers')"
  [[ "$app_name" =~ ^[[:alnum:]À-ÿ._\ -]+$ ]] || die 'Use letters, numbers, spaces, dots, dashes or underscores in the display name.'
  super_email="$(read_default 'Local PocketBase administrator email' 'admin@example.com')"
  driver_name="$(read_default 'Synthetic demo driver name' 'Mario Demo')"
  driver_email="$(read_default 'Synthetic demo driver email' 'driver@example.com')"
  port="$(read_default 'Local HTTP port' '8090')"
  if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1024 || port > 65535 )); then
    die 'Port must be between 1024 and 65535.'
  fi

  printf '\nAccess mode:\n  1) local/LAN demo\n  2) Cloudflare Tunnel\n'
  read -r -p 'Choose [1]: ' mode_choice
  case "${mode_choice:-1}" in
    1)
      deployment_mode=local
      bind_address="$(read_default 'Bind address' '127.0.0.1')"
      public_url="$(read_default 'Public URL used by the app' "http://127.0.0.1:$port")"
      ;;
    2)
      deployment_mode=remote
      bind_address=127.0.0.1
      public_url="$(read_default 'Public HTTPS URL' 'https://drivers.example.com')"
      printf '\nRoute the Cloudflare Public Hostname service to: http://pocketbase:8090\n'
      tunnel_token="$(read_secret 'Cloudflare tunnel token')"
      [[ -n "$tunnel_token" ]] || die 'Cloudflare token is required for remote mode.'
      ;;
    *)
      die 'Choose 1 or 2.'
      ;;
  esac

  read -r -p 'Configure Telegram notifications now? [y/N] ' telegram_answer
  if [[ "${telegram_answer,,}" == y ]]; then
    telegram_token="$(read_secret 'Telegram bot token')"
    telegram_chat="$(read_default 'Telegram chat ID' '')"
  fi

  super_password="$(random_hex 16)"
  driver_password="$(random_hex 12)"
  encryption_key="$(random_hex 16)"

  cat > "$ENV_FILE.tmp" <<ENV
DEPLOYMENT_MODE="$deployment_mode"
PB_VERSION="0.39.9"
PB_BIND_ADDRESS="$bind_address"
PB_PORT="$port"
PUBLIC_BASE_URL="$(env_escape "$public_url")"
APP_DISPLAY_NAME="$(env_escape "$app_name")"
PB_ENCRYPTION_KEY="$encryption_key"
PB_SUPERUSER_EMAIL="$(env_escape "$super_email")"
PB_SUPERUSER_PASSWORD="$super_password"
DEMO_DRIVER_NAME="$(env_escape "$driver_name")"
DEMO_DRIVER_EMAIL="$(env_escape "$driver_email")"
DEMO_DRIVER_PASSWORD="$driver_password"
TELEGRAM_BOT_TOKEN="$telegram_token"
TELEGRAM_CHAT_ID="$telegram_chat"
CLOUDFLARE_TOKEN="$tunnel_token"
ENV

  chmod 600 "$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  load_env
  start_stack
  print_ready
}

start() {
  require_docker
  need curl
  load_env
  start_stack
  ok "Started: $PUBLIC_BASE_URL"
}

stop() {
  require_docker
  load_env
  compose down
  ok 'Stopped; the managed PocketBase data volume was preserved.'
}

status() {
  require_docker
  load_env
  compose ps
}

logs() {
  require_docker
  load_env
  local service="${1:-pocketbase}"
  [[ "$service" =~ ^(pocketbase|tunnel)$ ]] || die 'Service must be pocketbase or tunnel.'
  compose logs --tail=180 -f "$service"
}

doctor() {
  local failures=0 state auth_code mode
  printf "%bPwaTruckPocket doctor%b\n\n" "$BOLD" "$RESET"

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    ok '[ok] Docker Compose v2'
  else
    warn '[fail] Docker Compose v2'
    failures=$((failures+1))
  fi

  if docker info >/dev/null 2>&1; then
    ok '[ok] Docker daemon reachable'
  else
    warn '[fail] Docker daemon unreachable'
    failures=$((failures+1))
  fi

  [[ -f "$ENV_FILE" ]] || die '[fail] .env missing; run setup first.'
  ok '[ok] .env exists'
  load_env

  if compose config --quiet >/dev/null 2>&1; then
    ok '[ok] Compose configuration valid'
  else
    warn '[fail] Compose configuration invalid'
    failures=$((failures+1))
  fi

  state="$(service_state pocketbase)"
  if [[ "$state" == healthy ]]; then
    ok '[ok] PocketBase healthy'
  else
    warn "[fail] PocketBase: $state"
    failures=$((failures+1))
  fi

  if command -v curl >/dev/null 2>&1; then
    if curl -fsS --max-time 12 "http://127.0.0.1:${PB_PORT}/api/health" >/dev/null; then
      ok '[ok] health API'
    else
      warn '[fail] health API'
      failures=$((failures+1))
    fi

    auth_code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 12 \
      "http://127.0.0.1:${PB_PORT}/api/collections/users/auth-with-password" \
      -H 'Content-Type: application/json' \
      --data "{\"identity\":\"$DEMO_DRIVER_EMAIL\",\"password\":\"$DEMO_DRIVER_PASSWORD\"}" || true)"
    if [[ "$auth_code" == 200 ]]; then
      ok '[ok] synthetic demo driver login'
    else
      warn "[fail] demo driver login: HTTP $auth_code"
      failures=$((failures+1))
    fi
  else
    warn '[fail] curl missing'
    failures=$((failures+1))
  fi

  if docker volume inspect "$DATA_VOLUME" >/dev/null 2>&1; then
    ok '[ok] managed data volume exists'
  else
    warn '[fail] managed data volume missing'
    failures=$((failures+1))
  fi

  mode="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || stat -f '%Lp' "$ENV_FILE" 2>/dev/null || printf '?')"
  if [[ "$mode" == 600 ]]; then
    ok '[ok] .env permissions: 600'
  else
    warn "[warn] .env permissions: $mode"
  fi

  if (( failures == 0 )); then
    ok 'Doctor completed: no blocking problems found.'
  else
    die "Doctor found $failures blocking problem(s)."
  fi
}

backup() {
  require_docker
  load_env
  mkdir -p "$BACKUP_DIR"
  docker volume inspect "$DATA_VOLUME" >/dev/null 2>&1 || die 'PocketBase data volume does not exist.'

  local stamp filename target
  stamp="$(date +%Y%m%d_%H%M%S)"
  filename="pwatruckpocket-$stamp.tar.gz"
  target="$BACKUP_DIR/$filename"

  info 'Stopping PocketBase briefly for a consistent data-volume snapshot...'
  compose stop pocketbase
  trap 'compose start pocketbase >/dev/null 2>&1 || true' EXIT

  docker run --rm \
    -v "$DATA_VOLUME:/data:ro" \
    -v "$BACKUP_DIR:/backup" \
    alpine:3.21 \
    tar -czf "/backup/$filename" -C /data .

  compose start pocketbase >/dev/null
  trap - EXIT
  wait_for_pocketbase
  [[ -s "$target" ]] || die 'Backup archive was not created correctly.'
  ok "Backup created: $target"
}

update_stack() {
  require_docker
  load_env
  backup
  compose build --pull pocketbase
  compose pull tunnel >/dev/null 2>&1 || true
  compose up -d --remove-orphans
  wait_for_pocketbase
  ok 'Update completed.'
}

credentials() {
  load_env
  printf 'URL:      %s\nDriver:   %s\nPassword: %s\nAdmin:    %s\n' \
    "$PUBLIC_BASE_URL" "$DEMO_DRIVER_EMAIL" "$DEMO_DRIVER_PASSWORD" "$PB_SUPERUSER_EMAIL"
}

demo() {
  load_env
  printf "%bThree-minute demo%b\n\n" "$BOLD" "$RESET"
  printf '1. Open %s\n2. Login as %s\n3. Send a trip status.\n4. Upload a synthetic image or PDF.\n5. Switch the browser offline, send another item, then reconnect and press Sync.\n6. Open History and show only the authenticated driver records.\n' \
    "$PUBLIC_BASE_URL" "$DEMO_DRIVER_EMAIL"
  if [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]]; then
    printf '7. Confirm the server-side Telegram notification.\n'
  else
    printf '7. Telegram is optional and currently disabled.\n'
  fi
}

main() {
  cd "$ROOT_DIR"
  case "${1:-help}" in
    setup) setup ;;
    start|up) start ;;
    stop|down) stop ;;
    status|ps) status ;;
    doctor|check) doctor ;;
    logs) shift; logs "${1:-pocketbase}" ;;
    backup) backup ;;
    update) update_stack ;;
    demo) demo ;;
    credentials) credentials ;;
    help|-h|--help) usage ;;
    *) usage; die "Unknown command: $1" ;;
  esac
}

main "$@"
